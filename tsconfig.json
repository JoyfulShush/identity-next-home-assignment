{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "lib": ["ES2022"],
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "types": ["node", "jest"],
        "paths": {
            "redlock": ["./node_modules/redlock/dist/index.d.ts"]
        },
        "declaration": false,
        "sourceMap": true,
        "isolatedModules": true,
        "noEmit": true
    },
    "include": ["src", "test"],
    "exclude": ["node_modules", "dist"]
}
